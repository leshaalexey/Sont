{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sont",
  "version": "0.1.0",
  "identifier": "app.sont.tray",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sont",
        "width": 450,
        "height": 525,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
