{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права окна трея. Список закрытый: окно умеет ровно то, что ему нужно, и ничего сверх — файловая система, сеть и запуск процессов ему недоступны.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-path",
    "dialog:allow-open"
  ]
}
